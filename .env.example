PORT=3000
# Produccion detras de Nginx: usar 127.0.0.1.
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jme
DB_USER=jme
DB_PASSWORD=
# Solo durante la creacion del administrador (minimo 12 caracteres).
SEED_ADMIN_PASSWORD=
# Frontend: URL publica completa, incluida /api. Vacio usa /api local.
VITE_API_URL=
# Backend: origenes exactos separados por comas, sin barra final.
CORS_ORIGINS=
